  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *",
      "git clone *",
      "gh *",
      "npm run issue*",
      "npm run wrap-up *",
