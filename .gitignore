node_modules/
dist/
coverage/
tsconfig.tsbuildinfo
.claude/settings.local.json

# Issue and session workspaces, plus Claude Code's own worktrees.
.claude/worktrees/
.DS_Store

# OAuth client secrets live outside the repo; this is belt-and-braces.
client_secret*.json
.clasprc.json*

# Full JSON responses from `*:probe`, in each package's .probe/ — live spreadsheet data, never committed.
.probe/

# Spreadsheet and script IDs stay local; each package commits a .example.json to copy instead.
sheets.config.json
.clasp.json

# The runner's state: run state, progress logs, raw step logs, wrap-up facts and progress files.
.runner/


# Each package is its own repo, cloned here.
packages/*

# No lockfile: each cloned workspace is its own repo, so a root lockfile would pin them all.
package-lock.json
