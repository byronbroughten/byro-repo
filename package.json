{
  "name": "byro-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "config",
    "runner",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/lint/prepare.ts",
    "check": "node scripts/runner/check.ts",
    "tsc": "node scripts/tsc/tsc.ts",
    "lint": "node scripts/lint/lint.ts",
    "lint:docs": "lint-docs --published config",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project real-estate --project tooling && npm run test:coverage --workspaces --if-present",
    "app:chore": "npm run chore -w sheets-real-estate --",
    "app:gen:configs": "npm run gen:configs -w sheets-real-estate --",
    "app:probe": "npm run probe -w sheets-real-estate --",
    "app:build": "npm run build -w sheets-real-estate --",
    "app:deploy": "npm run deploy -w sheets-real-estate --",
    "app:configs:diff": "npm run configs:diff -w sheets-real-estate --",
    "dev:chore": "npm run chore -w @byronbroughten/sheets-framework --",
    "dev:gen:configs": "npm run gen:configs -w @byronbroughten/sheets-framework --",
    "dev:probe": "npm run probe -w @byronbroughten/sheets-framework --",
    "dev:build": "npm run build -w @byronbroughten/sheets-framework --",
    "dev:deploy": "npm run deploy -w @byronbroughten/sheets-framework --",
    "dev:configs:diff": "npm run configs:diff -w @byronbroughten/sheets-framework --",
    "dev:push": "npm run push -w @byronbroughten/sheets-framework --",
    "dev:run": "npm run run -w @byronbroughten/sheets-framework --",
    "issue:list": "node scripts/runner/issue.ts list",
    "issue:start": "node scripts/runner/issue.ts start",
    "issue:promote": "node scripts/runner/issue.ts promote",
    "issue:read": "node scripts/runner/issueRead.ts",
    "issue:backlink": "node scripts/runner/issueBacklink.ts",
    "issue:remove": "node scripts/runner/issue.ts remove",
    "runner": "node scripts/runner/run.ts",
    "runner:tmux": "bash scripts/runner/tmux.sh",
    "session:probe": "node scripts/runner/sessionProbe.ts",
    "wrap-up": "node scripts/runner/wrapUp.ts",
    "jev": "node scripts/jev/jev.ts",
    "jev:style": "node scripts/jev/jevStyle.ts",
    "overlap": "node scripts/overlap/overlap.ts",
    "pdf:text": "node scripts/quotes/pdfText.ts",
    "verify:quotes": "node scripts/quotes/verifyQuotes.ts"
  },
  "devDependencies": {
    "@byronbroughten/config": "^0.1.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "^22.20.4",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.35.0",
    "prettier": "3.9.6",
    "rollup": "^4.54.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "prettier": "@byronbroughten/config/prettier"
}
