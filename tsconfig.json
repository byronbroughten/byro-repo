{
  // The tooling program: Claude Code hooks and skill scripts, run by Node's type stripping (node file.ts), so erasable syntax only.
  "extends": "@byronbroughten/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    ".claude/hooks/**/*.ts",
    ".claude/skills/**/*.ts",
    ".cursor/hooks/**/*.ts"
  ]
}
