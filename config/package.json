{
  "name": "@byronbroughten/config",
  "version": "0.1.1",
  "description": "General tooling for TypeScript projects: an ESLint flat-config preset, the prettier config, a base tsconfig and a doc linter.",
  "type": "module",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.json",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "bin": {
    "lint-docs": "./lintDocs.js"
  },
  "files": [
    "eslint.js",
    "prettier.json",
    "tsconfig.base.json",
    "docLint.js",
    "lintDocs.js",
    "docs"
  ],
  "dependencies": {
    "@eslint/js": "^9.35.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "typescript-eslint": "^8.43.0"
  },
  "peerDependencies": {
    "eslint": "^9.35.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "tsc": "tsc -p ."
  }
}
